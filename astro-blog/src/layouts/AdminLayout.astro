---
import '@styles/global.css';
import AdminGuard from '@components/vue/AdminGuard.vue';

interface Props { title?: string }
const { title } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title || '管理后台'} - Ray的垃圾站</title>
</head>
<body class="min-h-screen flex" style="background: rgba(245,245,247,0.85); backdrop-filter: blur(8px);">
  <!-- Sidebar -->
  <aside class="w-56 bg-gray-900/95 text-white min-h-screen flex-shrink-0 flex flex-col backdrop-blur">
    <div class="px-5 py-5 border-b border-gray-800">
      <a href="/admin" class="text-lg font-bold tracking-tight no-underline text-white">管理后台</a>
      <p class="text-xs text-gray-500 mt-0.5">Ray的垃圾站</p>
    </div>
    <nav class="flex-1 px-3 py-4 space-y-1">
      <a href="/admin" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${path === '/admin' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800'}`}>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        仪表盘
      </a>
      <a href="/admin/articles" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${path.startsWith('/admin/articles') ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800'}`}>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
        文章管理
      </a>
      <a href="/admin/categories" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${path === '/admin/categories' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800'}`}>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        分类管理
      </a>
      <a href="/admin/projects" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${path === '/admin/projects' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800'}`}>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        项目管理
      </a>
      <a href="/admin/music" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${path === '/admin/music' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800'}`}>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>
        音乐管理
      </a>
      <a href="/admin/announcements" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${path === '/admin/announcements' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800'}`}>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
        公告管理
      </a>
      <a href="/admin/users" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${path === '/admin/users' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800'}`}>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/></svg>
        用户管理
      </a>
      <a href="/admin/rag" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${path === '/admin/rag' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800'}`}>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        知识库
      </a>
      <a href="/admin/api-keys" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${path === '/admin/api-keys' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800'}`}>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
        API Key
      </a>
    </nav>
    <div class="px-5 py-4 border-t border-gray-800">
      <a href="/" class="text-xs text-gray-500 hover:text-gray-300 transition-colors">← 返回前台</a>
    </div>
  </aside>

  <!-- Main -->
  <div class="flex-1 flex flex-col min-w-0">
    <header class="h-14 border-b flex items-center justify-between px-6" style="background: rgba(255,255,255,0.5); backdrop-filter: blur(8px);">
      <h1 class="text-sm font-semibold text-gray-700">{title || '仪表盘'}</h1>
      <div class="flex items-center gap-3">
        <span class="text-xs text-gray-400">admin</span>
        <a href="/" class="text-xs text-gray-400 hover:text-gray-600">退出</a>
      </div>
    </header>
    <main class="flex-1 p-6 overflow-auto">
      <AdminGuard client:only="vue">
        <slot />
      </AdminGuard>
    </main>
  </div>
</body>
</html>