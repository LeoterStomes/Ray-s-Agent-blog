---
import SEO from '@components/astro/SEO.astro';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO title="登录 - Ray的垃圾站" />
  </head>
  <body class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-brand-50 via-purple-50 to-pink-50">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -left-40 w-80 h-80 rounded-full bg-brand-200/30 blur-3xl" />
      <div class="absolute -bottom-40 -right-40 w-80 h-80 rounded-full bg-purple-200/30 blur-3xl" />
    </div>
    <div class="relative w-full max-w-md glass-card p-8 shadow-xl animate-fade-in">
      <div class="text-center mb-6">
        <a href="/" class="text-2xl font-bold brand-text no-underline">@Ray的垃圾站</a>
      </div>
      <slot />
    </div>
  </body>
</html>
