---
import FavoriteButton from '@components/vue/FavoriteButton.vue';

interface Props {
  articleId: string; title: string; coverImage?: string;
  categoryName?: string; tags?: string[]; publishedAt: Date; readTime: number;
}
const { articleId, title, coverImage, categoryName, tags, publishedAt, readTime } = Astro.props;
function fmt(d: Date) { return new Date(d).toLocaleDateString('zh-CN', { year:'numeric', month:'long', day:'numeric' }); }
---

<article>
  { coverImage && (
    <div class="cover-wrap mb-10">
      <img src={coverImage} alt={title} class="cover-img" onerror="this.parentElement.remove()" />
    </div>
  )}

  <header class="mb-10">
    { categoryName && <span class="cat-badge">{categoryName}</span> }
    <h1 class="article-title">{title}</h1>
    <div class="meta-row">
      <span class="meta-item">{fmt(publishedAt)}</span>
      <span class="meta-dot">&middot;</span>
      <span class="meta-item">{readTime} 分钟阅读</span>
      { articleId && <FavoriteButton client:only="vue" articleId={articleId} /> }
    </div>
    { tags && tags.length > 0 && (
      <div class="tags-row">
        {tags.map(t => <span class="tag">#{t}</span>)}
      </div>
    )}
  </header>

  <div class="article-body">
    <slot />
  </div>

  <footer class="article-footer">
    <a href="/blog" class="back-link">
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      返回博客列表
    </a>
  </footer>
</article>

<style>
  /* Cover */
  .cover-wrap { border-radius: 16px; overflow: hidden; }
  .cover-img { width: 100%; max-height: 420px; object-fit: cover; display: block; }

  /* Title */
  .article-title { font-size: 2.25rem; font-weight: 800; color: #fff; line-height: 1.3; margin: .35em 0 .4em; letter-spacing: -.02em; }
  @media (max-width: 640px) { .article-title { font-size: 1.6rem; } }

  /* Category */
  .cat-badge { display: inline-block; padding: 4px 14px; border-radius: 20px; background: #312e81; color: #a5b4fc; font-size: 13px; font-weight: 600; margin-bottom: 8px; }

  /* Meta */
  .meta-row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding-bottom: 20px; border-bottom: 1px solid #1e293b; }
  .meta-item { font-size: 14px; color: #64748b; }
  .meta-dot { color: #475569; }

  /* Tags */
  .tags-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .tag { font-size: 12px; padding: 4px 12px; border-radius: 14px; background: #1e293b; color: #94a3b8; border: 1px solid #334155; }

  /* Footer */
  .article-footer { margin-top: 48px; padding-top: 24px; border-top: 1px solid #1e293b; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: #818cf8; font-weight: 500; text-decoration: none; transition: gap .2s; }
  .back-link:hover { gap: 10px; color: #a5b4fc; }

  /* Body */
  .article-body { font-size: 16px; line-height: 1.9; color: #fff; }
  .article-body h1 { font-size: 1.5em; font-weight: 700; margin: 1.6em 0 .5em; color: #fff; }
  .article-body h2 { font-size: 1.25em; font-weight: 700; margin: 1.5em 0 .5em; color: #fff; }
  .article-body h3 { font-size: 1.1em; font-weight: 600; margin: 1.3em 0 .4em; color: #fff; }
  .article-body p { margin: .75em 0; color: #e2e8f0; }
  .article-body a { color: #a5b4fc; text-decoration: none; border-bottom: 1px solid #6366f1; }
  .article-body a:hover { border-color: #a5b4fc; color: #c7d2fe; }
  .article-body strong { color: #fff; }
  .article-body pre { background: #0f172a; color: #e2e8f0; padding: 20px 24px; border-radius: 12px; overflow-x: auto; font-size: 14px; line-height: 1.7; margin: 1.2em 0; border: 1px solid #1e293b; }
  .article-body pre code { background: none; color: inherit; padding: 0; font-size: inherit; }
  .article-body code { background: #312e81; color: #c7d2fe; padding: 2px 6px; border-radius: 4px; font-size: .9em; }
  .article-body blockquote { border-left: 3px solid #6366f1; background: #1e1b4b; padding: 14px 20px; margin: 1.2em 0; border-radius: 0 8px 8px 0; color: #c7d2fe; }
  .article-body blockquote p { margin: .3em 0; }
  .article-body img { max-width: 100%; border-radius: 12px; margin: 1.2em auto; display: block; }
  .article-body ul, .article-body ol { padding-left: 1.5em; margin: .6em 0; color: #e2e8f0; }
  .article-body li { margin: .35em 0; }
  .article-body li::marker { color: #818cf8; }
  .article-body table { width: 100%; border-collapse: collapse; margin: 1em 0; font-size: 14px; }
  .article-body th, .article-body td { border: 1px solid #334155; padding: 10px 14px; text-align: left; }
  .article-body th { background: #1e293b; font-weight: 600; color: #e2e8f0; }

</style>
