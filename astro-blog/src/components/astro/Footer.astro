---
import { SITE } from '@lib/constants';
---

<footer class="mt-20 py-12 border-t border-gray-100/60 backdrop-blur-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="text-lg font-bold brand-text">@{SITE.title}</span>
        <span class="text-xs text-gray-400">{SITE.subtitle}</span>
      </div>
      <p class="text-sm text-gray-400">
        &copy; {new Date().getFullYear()} {SITE.title}. {SITE.description}
      </p>
    </div>
  </div>
</footer>
