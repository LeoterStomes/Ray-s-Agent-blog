---
export const prerender = false;
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogPostLayout from '@layouts/BlogPostLayout.astro';
import CommentSection from '@components/vue/CommentSection.vue';

const slug = Astro.params.slug;
const API_BASE = import.meta.env.PUBLIC_API_BASE || 'http://localhost:1235';
const apiUrl = `${API_BASE}/api/knowledge/article/${slug}`;

let article: any = {}, notFound = false;
try {
  const res = await fetch(apiUrl);
  const json = await res.json();
  if (json.code === '200' && json.data) article = json.data;
  else notFound = true;
} catch { notFound = true; }

const title = article.title || '文章';
const content = article.content || '';
const coverImage = article.coverImage || '';
const tags: string[] = article.tags ? article.tags.split(',').filter(Boolean) : [];
const categoryName = article.categoryName || '';
const publishedAt = article.publishedAt ? new Date(article.publishedAt) : new Date();
const readTime = Math.max(1, Math.ceil((content?.length || 0) / 300));

// TOC
interface TocItem { id: string; text: string; level: number; }
const toc: TocItem[] = [];
if (content) {
  const re = /<h([1-3])\b[^>]*>(.*?)<\/h\1>/gi;
  let m, n = 0;
  while ((m = re.exec(content)) !== null) {
    n++;
    toc.push({ id: `toc-${n}`, text: m[2].replace(/<[^>]+>/g,'').trim(), level: parseInt(m[1]) });
  }
}
let contentWithIds = content;
if (toc.length > 0) {
  let i = 0;
  contentWithIds = content.replace(/<h([1-3])\b/gi, (full: string) => {
    i++;
    return full.includes('id=') ? full : full.replace(/<h[1-3]/i, full.match(/<h[1-3]/i)![0] + ` id="toc-${i}"`);
  });
}

// Related
let related: any[] = [];
try {
  const r = await fetch(`${API_BASE}/api/knowledge/article/page?status=1&size=4&categoryId=${article.categoryId||''}`);
  const j = await r.json();
  if (j.code==='200' && j.data?.records) related = j.data.records.filter((x:any) => x.id!==article.id).slice(0,3);
} catch {}
---

<BaseLayout title={title} description={article.summary||''}>
  { notFound ? (
    <div class="max-w-3xl mx-auto px-4 pt-20 pb-12 text-center">
      <p class="text-8xl mb-4 font-black text-gray-200">404</p>
      <p class="text-gray-400 text-lg mb-6">文章不存在</p>
      <a href="/blog" class="text-indigo-500 hover:text-indigo-600 text-sm">&larr; 返回博客列表</a>
    </div>
  ) : (
    <div style="background:#0b0f19;min-height:100vh" data-article-page>
      <div class="mx-auto px-6 pt-12 pb-16" style="max-width:1280px">
        <div class="flex gap-8 max-lg:flex-col">

          {/* ─── 左侧目录 ─── */}
          <aside class="toc-sidebar max-lg:hidden">
            <div class="toc-card">
              <p class="toc-title">目录</p>
              <nav class="toc-nav" id="toc-nav">
                {toc.map((item, idx) => (
                  <a href={`#${item.id}`} data-toc-id={item.id}
                    class={`toc-link ${item.level===1?'toc-h1':item.level===2?'toc-h2':'toc-h3'}`}>
                    {item.text}
                  </a>
                ))}
              </nav>
            </div>
          </aside>

          {/* ─── 中间正文 ─── */}
          <div class="flex-1 min-w-0" style="max-width:780px">
            <div class="content-card">
              <BlogPostLayout
                articleId={article.id||''} title={title} coverImage={coverImage}
                categoryName={categoryName} tags={tags} publishedAt={publishedAt} readTime={readTime}>
                <Fragment set:html={contentWithIds} />
              </BlogPostLayout>
              <CommentSection client:only="vue" articleId={article.id||''} />
            </div>
          </div>

          {/* ─── 右侧推荐 ─── */}
          <aside class="w-[240px] flex-shrink-0 max-lg:hidden">
            <div class="sticky top-24">
              <div class="related-card">
                <p class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-5">相关推荐</p>
                <div class="space-y-5">
                  {related.map((r:any) => (
                    <a href={`/blog/${r.id}`} class="block group no-underline">
                      {r.coverImage && <img src={r.coverImage} alt={r.title} class="w-full h-28 object-cover rounded-xl mb-3" loading="lazy" onerror="this.style.display='none'" />}
                      <h4 class="text-sm font-medium text-gray-300 group-hover:text-indigo-400 transition-colors line-clamp-2 leading-snug">{r.title}</h4>
                      <div class="flex items-center gap-2 mt-1.5 text-xs text-gray-500">
                        <span>{r.categoryName}</span><span>&middot;</span><span>{r.readCount||0} 阅读</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  )}

  {/* 文章页暗色背景，离开时恢复壁纸 */}
  <script>
    (function(){
      var isArticle = !!document.querySelector('[data-article-page]');
      if(isArticle){
        document.body.style.setProperty('background','#0b0f19','important');
      }
      document.addEventListener('astro:after-swap', function(){
        var onArticle = !!document.querySelector('[data-article-page]');
        if(onArticle){
          document.body.style.setProperty('background','#0b0f19','important');
        } else {
          // 恢复壁纸
          var cached = localStorage.getItem('_bgUrl');
          if(cached) {
            document.body.style.setProperty('background','url('+cached+') center / cover fixed','important');
          } else {
            document.body.style.setProperty('background','#ffffff','important');
          }
        }
      });
    })();
  </script>

  {/* 返回 Agent 浮钮 — 带回上次会话 */}
  <a href="/agent" id="agent-back-btn" class="fixed bottom-20 left-6 z-50 w-12 h-12 rounded-full bg-brand-600 text-white shadow-lg hover:bg-brand-700 hover:scale-105 transition-all flex items-center justify-center agent-float-btn" title="AI 助手"
    onclick="var s=localStorage.getItem('agentSessionId');if(s){location.href='/agent?session='+s;return false;}">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg>
  </a>

  {toc.length>0 && (<script>
    (function(){
      const links = document.querySelectorAll('.toc-link');
      const headings = [...document.querySelectorAll('[id^="toc-"]')];
      if(!links.length||!headings.length) return;
      const observer = new IntersectionObserver(entries => {
        let id = '';
        entries.forEach(e => { if(e.isIntersecting) id = e.target.id; });
        links.forEach(a => { a.classList.toggle('toc-active', a.dataset.tocId===id); });
      }, { rootMargin: '-60px 0px -70% 0px' });
      headings.forEach(h => observer.observe(h));
    })();
  </script>)}
</BaseLayout>

<style>
  .toc-sidebar { width: 200px; flex-shrink: 0; }
  .toc-card {
    position: sticky; top: 88px;
    border: 1px solid #1e293b; border-radius: 16px; padding: 20px;
    background: rgba(15,23,42,.5); backdrop-filter: blur(8px);
  }
  .toc-title { font-size: 14px; font-weight: 600; color: #94a3b8; margin-bottom: 16px; }
  .toc-nav { border-left: 2px solid #1e293b; }
  .toc-link { display: block; font-size: 14px; padding: 7px 0 7px 16px; color: #64748b; text-decoration: none; transition: all .15s; line-height: 1.4; position: relative; }
  .toc-link::before { content: ''; position: absolute; left: -2px; top: 0; bottom: 0; width: 2px; background: transparent; transition: background .2s; }
  .toc-link:hover { color: #a5b4fc; }
  .toc-link.toc-active { color: #818cf8; font-weight: 600; }
  .toc-link.toc-active::before { background: #818cf8; }
  .toc-h1 { font-weight: 500; color: #94a3b8; }
  .toc-h2 { padding-left: 28px; font-size: 13px; }
  .toc-h3 { padding-left: 40px; font-size: 12px; }

  /* 正文卡片 */
  .content-card {
    border: 1px solid #1e293b; border-radius: 16px; padding: 40px 48px;
    background: rgba(15,23,42,.6); backdrop-filter: blur(8px);
  }
  @media (max-width: 640px) { .content-card { padding: 20px; } }

  /* 推荐卡片 */
  .related-card {
    border: 1px solid #1e293b; border-radius: 16px; padding: 20px;
    background: rgba(15,23,42,.5); backdrop-filter: blur(8px);
  }
  .related-card h4:hover { color: #a5b4fc !important; }
  .agent-float-btn { animation: agent-float 3s ease-in-out infinite; }
  @keyframes agent-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

</style>
