---
export const prerender = false;

import BaseLayout from '@layouts/BaseLayout.astro';
import BlogListClient from '@components/vue/BlogListClient.vue';
---

<BaseLayout title="博客">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 pb-12">
    <div class="mb-10">
      <h1 class="text-3xl font-bold brand-text mb-2">博客</h1>
      <p class="text-gray-500">共 <span id="total-articles">...</span> 篇文章</p>
    </div>
    <BlogListClient client:only="vue" />
  </section>
</BaseLayout>