---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <section class="max-w-xl mx-auto px-4 pt-32 pb-20 text-center">
    <p class="text-7xl font-extrabold brand-text mb-4">404</p>
    <h1 class="text-xl font-semibold text-gray-700 mb-2">页面未找到</h1>
    <p class="text-gray-400 mb-8">您访问的页面不存在或已被移除。</p>
    <a
      href="/"
      class="inline-block px-6 py-2.5 rounded-button bg-brand-600 text-white font-medium hover:bg-brand-700 transition-colors"
    >
      返回首页
    </a>
  </section>
</BaseLayout>
