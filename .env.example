# ========================================
# 数据库配置 | Database Configuration
# ========================================
# 格式: mysql+pymysql://<用户名>:<密码>@<主机>:<端口>/<数据库名>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/blog_db?charset=utf8mb4

# ========================================
# JWT 认证配置 | JWT Authentication
# ========================================
# 生成强密钥：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-very-secret-key-here-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ========================================
# AI API 配置 | AI API Configuration
# ========================================
# DeepSeek API: https://platform.deepseek.com/
# 用于 Agent 对话、文章摘要等所有 AI 功能
AI_API_KEY=sk-your-deepseek-api-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ========================================
# CORS 配置 | CORS Configuration
# ========================================
# 允许的前端域名，逗号分隔
CORS_ORIGINS=http://localhost:4321,http://localhost:3000,http://127.0.0.1:4321

# ========================================
# 邮件 SMTP 配置 | Email SMTP Configuration
# ========================================
# 用于注册时的邮箱验证码发送
# QQ邮箱: smtp.qq.com:587（需去 mail.qq.com 生成授权码）
# 163邮箱: smtp.163.com:465
# Gmail: smtp.gmail.com:587
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM_NAME=Ray的垃圾站

# ========================================
# MCP 外部服务（可选）| MCP Servers (Optional)
# ========================================
# 每行一个 JSON，支持 stdio 和 HTTP 两种传输
# Stdio: {"name":"xxx","command":"npx","args":"-y package-name"}
# HTTP:  {"name":"xxx","url":"https://mcp.example.com/mcp?key=YOUR_KEY"}
# 不配置则仅使用内置 12 个工具
# MCP_SERVERS={"name":"amap","url":"https://mcp.amap.com/mcp?key=YOUR_KEY"}
